function closeViewer(){document.getElementById('pdfViewer').classList.remove('on');document.getElementById('pvFrame').src='about:blank'}
document.addEventListener('keydown',e=>{if(e.key==='Escape'){if(document.getElementById('pdfViewer').classList.contains('on'))closeViewer();else closeNotes()}});

/* ---------- lottery: show the topic's PDFs under the draw ---------- */
function renderPickDocs(){
 let el=document.getElementById('pickDocs');
 if(!el){el=document.createElement('div');el.id='pickDocs';el.className='pickdocs';document.getElementById('cooldown').insertAdjacentElement('afterend',el)}
 const tid=data.current;
 if(!tid){el.innerHTML='';return}
 const a=nl()[tid]||[];
 el.innerHTML=a.length
  ?a.map(n=>`<button class="btn" onclick="openViewer('${n.id}','${tid}')">📄 ${esc(n.name)}</button>`).join('')
  :`<button class="btn" onclick="openNotes('${tid}')">＋ Link a PDF for this topic</button>`;
}
const _dt=drawTopic;
drawTopic=function(){
 _dt();
 const c=document.getElementById('cooldown');c.textContent=c.textContent.replace('10-minute','15-minute');
 renderPickDocs();
};

/* ---------- focus mode: 15 min + the same PDF embedded ---------- */
function showFocusDoc(i){
 const n=(nl()[fdTid]||[])[i];if(!n)return;
 document.getElementById('fdFrame').src=docSrc(n);
 document.querySelectorAll('#focusDoc .ftabs .btn').forEach((b,j)=>b.classList.toggle('on',j===i));
}
function mountFocusDoc(tid){
 const f=document.getElementById('focus'),box=f.querySelector('.focusbox');
 let btns=box.querySelector('.fbtns');
 if(!btns){btns=document.createElement('div');btns.className='fbtns';box.querySelectorAll(':scope > button').forEach(b=>btns.appendChild(b));box.appendChild(btns)}
 const old=document.getElementById('focusDoc');if(old)old.remove();
 const a=nl()[tid]||[];fdTid=tid;
 if(!a.length){f.classList.remove('hasdoc');return}
 const d=document.createElement('div');d.id='focusDoc';
 d.innerHTML=(a.length>1?'<div class="ftabs">'+a.map((n,i)=>`<button class="btn" onclick="showFocusDoc(${i})">${esc(n.name)}</button>`).join('')+'</div>':'')+'<div class="pvwrap"><iframe id="fdFrame" title="Revision PDF"></iframe><div class="pvblock"></div></div>';
 box.appendChild(d);f.classList.add('hasdoc');showFocusDoc(0);
}
function unmountFocusDoc(){
 const d=document.getElementById('focusDoc');if(d)d.remove();
 document.getElementById('focus').classList.remove('hasdoc');
}
const _sf=startFocus;
startFocus=function(){
 _sf();
 if(!focusTopicId)return;
 focusSeconds=FOCUS_SECONDS;renderFocusTimer(); // 15:00
 mountFocusDoc(focusTopicId);
};
const _ff=finishFocus;finishFocus=function(a){unmountFocusDoc();_ff(a)};
const _ef=exitFocus;exitFocus=function(){unmountFocusDoc();_ef()};

/* ---------- pull linked PDFs from cloud (keeps any not yet synced) ---------- */
async function pullNotes(){
 try{
  const rows=await cloudFetch('revision_notes?select=id,topic_id,file_name,storage_path,size_bytes,created_at&order=created_at.asc');
  if(!Array.isArray(rows))return;
  const m={};
  rows.forEach(r=>(m[r.topic_id]=m[r.topic_id]||[]).push({id:r.id,name:r.file_name,path:r.storage_path,size:r.size_bytes||0,at:r.created_at}));
  Object.entries(nl()).forEach(([tid,arr])=>arr.filter(n=>n.unsynced).forEach(n=>{const l=(m[tid]=m[tid]||[]);if(!l.some(x=>x.id===n.id))l.push(n)}));
  data.notes=m;persist();renderTree();if(noteTid)renderNotes();renderPickDocs();
 }catch(e){console.warn('Notes pull:',e)}
}
window.addEventListener('online',pullNotes);
window.addEventListener('load',()=>setTimeout(pullNotes,1500));
renderTree();
</script>
