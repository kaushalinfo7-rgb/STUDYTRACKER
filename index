<script>
/* ---------- helpers ---------- */
const NOTE_BUCKET='revision-notes',NKEY='kaushalStudyFocusV1',FOCUS_SECONDS=900;
let noteTid=null,fdTid=null;
const nl=()=>(data.notes=data.notes||{});
const noteCount=tid=>(nl()[tid]||[]).length;
const persist=()=>localStorage.setItem(NKEY,JSON.stringify(data));
const noteUrl=p=>KAUSHAL_CLOUD.url+'/storage/v1/object/public/'+NOTE_BUCKET+'/'+p; // old uploaded files still open
const driveId=u=>{u=(u||'').trim();const m=u.match(/\/d\/([\w-]{15,})/)||u.match(/[?&]id=([\w-]{15,})/);return m?m[1]:(/^[\w-]{25,}$/.test(u)?u:null)};
const docSrc=n=>n.path.includes('/')?noteUrl(n.path):'https://drive.google.com/file/d/'+n.path+'/preview';
const nMsg=m=>document.getElementById('nStatus').textContent=m;

/* ---------- 15-minute focus + label updates ---------- */
(function(){
 const q=s=>document.querySelector(s);
 const h=q('.lottery h2');if(h)h.textContent='15-Minute Revision Lottery';
 const b=document.getElementById('focusBtn');if(b)b.textContent='🔒 Start 15-Min Focus';
 const p=q('.hero p');if(p)p.textContent=p.textContent.replace('10-minute revision lottery','15-minute revision lottery');
 const t=document.getElementById('focusTimer');if(t)t.textContent='15:00';
})();
const _toast=toast;toast=function(s){_toast(String(s).replace('10-minute','15-minute'))};

/* ---------- sync fixes (unchanged, minutes now 15 per revision) ---------- */
cloudFetch=async function(path,opts={}){
 const r=await fetch(KAUSHAL_CLOUD.url+'/rest/v1/'+path,{...opts,headers:{...cloudHeaders(),...(opts.headers||{})}});
 if(!r.ok)throw new Error(await r.text());
 const tx=await r.text();return tx?JSON.parse(tx):null;
};
cloudPush=async function(){
 if(cloudBusy)return;cloudBusy=true;
 try{
  cloudStatus('☁ Saving to cloud…');
  const now=new Date().toISOString();
  const rows=Object.entries(data.completed||{}).map(([topic_id,v])=>({topic_id,completed:true,completed_at:new Date(v.at||Date.now()).toISOString(),updated_at:now}));
  (data.removed||[]).forEach(topic_id=>rows.push({topic_id,completed:false,completed_at:null,updated_at:now}));
  if(rows.length)await cloudFetch('topic_progress?on_conflict=topic_id',{method:'POST',body:JSON.stringify(rows)});
  data.removed=[];
  const pend=Object.entries(data.revisions||{}).filter(([k,v])=>!v.synced);
  if(pend.length){
   await cloudFetch('revision_history',{method:'POST',body:JSON.stringify(pend.map(([topic_id,v])=>({topic_id,revised_at:new Date(v.at||Date.now()).toISOString(),next_revision_at:new Date(addDays(v.date||today(),10)+'T12:00:00').toISOString()})))});
   pend.forEach(([k,v])=>v.synced=true);
  }
  const d=today();
  const tc=Object.values(data.completed||{}).filter(v=>v.date===d).length;
  const rc=Object.values(data.revisions||{}).filter(v=>v.date===d).length;
  await cloudFetch('daily_activity?on_conflict=activity_date',{method:'POST',body:JSON.stringify([{activity_date:d,topics_covered:tc,revisions_completed:rc,total_focus_minutes:rc*15,updated_at:now}])});
  persist();cloudStatus('✓ Cloud synced','ok');
 }catch(e){console.warn('Cloud sync:',e);cloudStatus('Cloud unavailable • saved locally','bad')}
 finally{cloudBusy=false}
};
const _tt=toggleTopic;
toggleTopic=function(tid){
 const was=!!data.completed[tid];_tt(tid);
 if(was)(data.removed=data.removed||[]).push(tid);
 else if(data.removed)data.removed=data.removed.filter(x=>x!==tid);
};
const _cp=cloudPull;
cloudPull=async function(){await _cp();Object.values(data.revisions||{}).forEach(v=>{if(v.next)v.synced=true});persist();};

/* ---------- tree decoration: 📄 button per topic + counts per group ---------- */
const _rt=renderTree;
renderTree=function(){
 const el=document.getElementById('tree');
 const open=[...el.querySelectorAll('details')].map(d=>d.open);
 _rt();
 el.querySelectorAll('.topic').forEach(row=>{
  const m=(row.querySelector('input').getAttribute('onchange')||'').match(/'([^']+)'/);if(!m)return;
  const n=noteCount(m[1]);row.dataset.n=n;
  row.insertAdjacentHTML('beforeend',`<button class="notebtn ${n?'has':''}" onclick="openNotes('${m[1]}')" title="Revision PDFs">📄 ${n||'+'}</button>`);
 });
 el.querySelectorAll('.node > details').forEach(g=>{
  const n=[...g.querySelectorAll('.topic')].reduce((a,r)=>a+(+r.dataset.n||0),0);
  if(n)g.querySelector('summary').insertAdjacentHTML('beforeend',`<span class="tag ntag">📄 ${n}</span>`);
 });
 if(!document.getElementById('search').value.trim())el.querySelectorAll('details').forEach((d,i)=>{if(open[i])d.open=true});
};

/* ---------- link manager ---------- */
function openNotes(tid){noteTid=tid;nMsg('In Drive: Share → General access → “Anyone with the link” (Viewer), so it can load here.');document.getElementById('notesModal').classList.add('on');renderNotes()}
function closeNotes(){document.getElementById('notesModal').classList.remove('on');noteTid=null}
