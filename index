<script>
(function(){
const pad=n=>String(n).padStart(2,'0');
const dayKey=t=>{const d=new Date(t);return d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate())}; // LOCAL date (IST), not UTC
const ms=v=>{const n=typeof v==='number'?v:Date.parse(v);return isNaN(n)?Date.now():n};
today=()=>dayKey(Date.now());
addDays=(ds,n)=>{const d=new Date(ds+'T12:00:00');d.setDate(d.getDate()+n);return dayKey(d)};

/* ---- clean/migrate stored data ---- */
function normalize(){
 if(!data||typeof data!=='object')data={};
 ['completed','revisions','changes','notes'].forEach(k=>{if(!data[k]||typeof data[k]!=='object'||Array.isArray(data[k]))data[k]={}});
 if(!Array.isArray(data.activity))data.activity=[];
 if(!Array.isArray(data.noteDel))data.noteDel=[];
 const ok=s=>/^\d{4}-\d\d-\d\d$/.test(s||'');
 Object.entries(data.completed).forEach(([k,v])=>{const at=ms(v&&v.at);data.completed[k]={at,date:ok(v&&v.date)?v.date:dayKey(at)}});
 Object.entries(data.revisions).forEach(([k,v])=>{const at=ms(v&&v.at);data.revisions[k]={at,date:ok(v&&v.date)?v.date:dayKey(at),synced:!!(v&&v.synced)}});
 if(Array.isArray(data.removed)){data.removed.forEach(t=>{if(!data.completed[t])data.changes[t]=Date.now()});delete data.removed}
}

/* ---- sync engine: pending changes + newest-wins merge ---- */
const page=async p=>{let o=[],off=0;for(;;){const r=await cloudFetch(p+(p.includes('?')?'&':'?')+'limit=1000&offset='+off)||[];o=o.concat(r);if(r.length<1000)return o;off+=1000}};
async function pull(){
 const p=await page('topic_progress?select=topic_id,completed,completed_at,updated_at&order=topic_id.asc');
 const r=await page('revision_history?select=topic_id,revised_at&order=revised_at.desc');
 const ch=data.changes,seen=new Set();
 p.forEach(x=>{
  seen.add(x.topic_id);
  if(ch[x.topic_id]&&ch[x.topic_id]>ms(x.updated_at))return;      // my unsynced change is newer: keep it
  delete ch[x.topic_id];
  if(x.completed){const at=ms(x.completed_at||x.updated_at);data.completed[x.topic_id]={at,date:dayKey(at)}}
  else delete data.completed[x.topic_id];
 });
 Object.entries(data.completed).forEach(([t,v])=>{if(!seen.has(t)&&!ch[t])ch[t]=v.at}); // done here, never reached cloud
 const done=new Set();
 r.forEach(x=>{
  if(done.has(x.topic_id))return;done.add(x.topic_id);
  const at=ms(x.revised_at),l=data.revisions[x.topic_id];
  if(l&&Math.abs(l.at-at)<1500){l.synced=true;return}
  if(l&&l.at>at)return;                                           // local revision is newer: keep, push later
  data.revisions[x.topic_id]={at,date:dayKey(at),synced:true};
 });
}
async function push(){
 const ch=data.changes,ids=Object.keys(ch),snap={...ch};
 const rows=ids.map(t=>{const c=data.completed[t];return{topic_id:t,completed:!!c,completed_at:c?new Date(c.at).toISOString():null,updated_at:new Date(snap[t]).toISOString()}});
 for(let i=0;i<rows.length;i+=200)await cloudFetch('topic_progress?on_conflict=topic_id',{method:'POST',body:JSON.stringify(rows.slice(i,i+200))});
 ids.forEach(t=>{if(ch[t]===snap[t])delete ch[t]});persist();
 const pend=Object.entries(data.revisions).filter(([k,v])=>!v.synced);
 if(pend.length){
  await cloudFetch('revision_history',{method:'POST',body:JSON.stringify(pend.map(([t,v])=>({topic_id:t,revised_at:new Date(v.at).toISOString(),next_revision_at:new Date(addDays(v.date,10)+'T12:00:00').toISOString()})))});
  pend.forEach(([k,v])=>v.synced=true);persist();
 }
 if(rows.length||pend.length){
  const days=new Set([today()]);rows.forEach(r=>r.completed&&days.add(dayKey(r.completed_at)));pend.forEach(([k,v])=>days.add(v.date));
  const out=[...days].map(d=>{const rc=Object.values(data.revisions).filter(v=>v.date===d).length;return{activity_date:d,topics_covered:Object.values(data.completed).filter(v=>v.date===d).length,revisions_completed:rc,total_focus_minutes:rc*15,updated_at:new Date().toISOString()}});
  await cloudFetch('daily_activity?on_conflict=activity_date',{method:'POST',body:JSON.stringify(out)});
 }
}
async function notes(){
 for(const nid of [...data.noteDel]){await cloudFetch('revision_notes?id=eq.'+nid,{method:'DELETE'});data.noteDel=data.noteDel.filter(x=>x!==nid)}
 for(const [tid,arr] of Object.entries(data.notes)){const t=TOPICS.find(z=>z.id===tid);if(!t)continue;
  for(const n of arr.filter(x=>x.unsynced)){await cloudFetch('revision_notes?on_conflict=id',{method:'POST',body:JSON.stringify([{id:n.id,topic_id:tid,subject:t.subject,group_name:t.group,topic_name:t.name,file_name:n.name,storage_path:n.path,size_bytes:0}])});delete n.unsynced}}
 const rows=await page('revision_notes?select=id,topic_id,file_name,storage_path,size_bytes,created_at&order=created_at.asc');
 const m={};rows.forEach(r=>(m[r.topic_id]=m[r.topic_id]||[]).push({id:r.id,name:r.file_name,path:r.storage_path,size:r.size_bytes||0,at:r.created_at}));
 data.notes=m;persist();
}
let q=Promise.resolve(),last=0;
function sync(){return q=q.then(async()=>{           // one sync at a time: nothing is dropped while a request is in flight
 try{cloudStatus('☁ Syncing…');await pull();await push();await notes();last=Date.now();persist();renderAll();renderPick();cloudStatus('✓ Cloud synced','ok')}
 catch(e){console.warn('Sync:',e);cloudStatus('Cloud unavailable • saved locally','bad')}
})}
window.cloudSync=sync;cloudPull=cloudPush=pullNotes=sync;
scheduleCloud=()=>{clearTimeout(cloudTimer);cloudTimer=setTimeout(sync,600)};
document.addEventListener('visibilitychange',()=>{if(!document.hidden&&!document.getElementById('focus').classList.contains('on')&&Date.now()-last>20000)sync()});

/* ---- actions that now record a timestamped change ---- */
toggleTopic=function(tid){
 if(data.completed[tid]){delete data.completed[tid];data.activity=data.activity.filter(a=>!(a.type==='covered'&&a.tid===tid));toast('Topic marked incomplete')}
 else{const at=Date.now();data.completed[tid]={at,date:today()};data.activity.unshift({type:'covered',tid,date:today(),at});toast('✓ Topic counted for today')}
 data.changes[tid]=Date.now();save();renderAll();
};
delNote=function(nid){
 const a=data.notes[noteTid]||[],n=a.find(x=>x.id===nid);
 if(!n||!confirm('Remove "'+n.name+'" from this topic on all devices? (Your Drive file is not deleted.)'))return;
 data.notes[noteTid]=a.filter(x=>x.id!==nid);if(!n.unsynced)data.noteDel.push(nid);
 persist();renderTree();renderNotes();renderPickDocs();sync();
};
importData=function(e){
 const f=e.target.files[0];if(!f)return;const r=new FileReader();
 r.onload=()=>{e.target.value='';try{
  const d=JSON.parse(r.result);if(!d||typeof d.completed!=='object')throw 0;
  if(!confirm('Replace your current progress (on all devices) with this backup?'))return;
  data=d;normalize();const n=Date.now();TOPICS.forEach(t=>data.changes[t.id]=n);
  Object.values(data.revisions).forEach(v=>v.synced=false);Object.values(data.notes).forEach(a=>a.forEach(x=>x.unsynced=true));data.noteDel=[];
  save();renderAll();renderPick();toast('✓ Backup imported');
 }catch(err){alert('Invalid backup file.')}};
 r.readAsText(f);
};

/* ---- stats / week now use local dates and synced data ---- */
const activeDays=()=>{const s=new Set();Object.values(data.completed).forEach(v=>s.add(v.date));Object.values(data.revisions).forEach(v=>s.add(v.date));data.activity.forEach(a=>{if(a.type==='revision'||data.completed[a.tid])s.add(a.date)});return s};
stats=function(){
 const $=i=>document.getElementById(i),ids=new Set(TOPICS.map(t=>t.id)),total=TOPICS.length,t=today();
 const done=Object.keys(data.completed).filter(k=>ids.has(k)).length;
 $('todayCount').textContent=Object.values(data.completed).filter(v=>v.date===t).length;
 $('totalCount').textContent=done+'/'+total;
 $('revisionCount').textContent=Object.keys(data.revisions).length;
 const s=activeDays();let d=new Date(),n=0;if(!s.has(dayKey(d)))d.setDate(d.getDate()-1);   // streak isn't lost just because today hasn't started
 while(s.has(dayKey(d))&&n<3650){n++;d.setDate(d.getDate()-1)}
 $('streak').textContent=n;const p=total?Math.round(done/total*100):0;$('heroPct').textContent=p+'\%';$('heroBar').style.width=p+'%';
};
renderWeek=function(){
 let tot=0,h='';
 for(let i=6;i>=0;i--){const d=new Date();d.setDate(d.getDate()-i);const k=dayKey(d);
  const n=Object.values(data.completed).filter(v=>v.date===k).length+Object.values(data.revisions).filter(v=>v.date===k).length;tot+=n;
  h+=`<div class="day ${n?'done':''}"><span>${d.toLocaleDateString(undefined,{weekday:'short'}).slice(0,3)}</span><b>${n}</b><small>${d.getDate()}</small></div>`}
 document.getElementById('week').innerHTML=h;document.getElementById('weekTotal').textContent=tot+' activities';
};

/* ---- search: hide empty subjects, auto-open groups so ticking doesn't collapse them ---- */
const _rt3=renderTree;
renderTree=function(){
 _rt3();const el=document.getElementById('tree');
 if(document.getElementById('search').value.trim()){
  [...el.children].forEach(s=>{if(s.tagName==='DETAILS'&&!s.querySelector('.topic'))s.remove()});
  el.querySelectorAll('details').forEach(d=>d.open=true);
  if(!el.children.length)el.innerHTML='<div class="empty">No topic found.</div>';
 }
};

/* ---- restore the drawn topic after a reload (focus used to start on a topic you couldn't see) ---- */
function renderPick(){
 const t=data.current&&TOPICS.find(x=>x.id===data.current);if(!t)return;
 document.getElementById('pick').textContent=t.name;
 document.getElementById('pickMeta').textContent=t.subject+' • '+t.group;
 document.getElementById('cooldown').textContent='Complete the 15-minute focus to start its 10-day revision cooldown.';
 renderPickDocs();
}
normalize();persist();renderAll();renderPick();
})();
</script>
