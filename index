<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#111827">
<title>KAUSHAL • Study Focus</title>
<style>
:root{
 --bg:#f5f7fb;--card:#fff;--text:#172033;--muted:#6b7280;--line:#e5e7eb;
 --accent:#4f46e5;--accent2:#7c3aed;--good:#059669;--warn:#d97706;--danger:#dc2626;
 --shadow:0 12px 35px rgba(15,23,42,.08);--r:20px
}
*{box-sizing:border-box}html,body{margin:0;min-height:100%;font-family:Inter,system-ui,-apple-system,Segoe UI,sans-serif;background:var(--bg);color:var(--text)}
button,input,select{font:inherit}button{cursor:pointer;border:0}
.app{max-width:1180px;margin:auto;padding:18px 16px 100px}
.top{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:18px}
.brand{font-weight:900;font-size:20px;letter-spacing:-.5px}.brand span{color:var(--accent)}
.actions{display:flex;gap:8px;flex-wrap:wrap}
.btn{padding:10px 14px;border-radius:12px;background:#fff;border:1px solid var(--line);font-weight:700;color:var(--text)}
.btn.primary{background:var(--accent);color:#fff;border-color:var(--accent)}.btn.danger{background:#fee2e2;color:#991b1b}
.hero{background:linear-gradient(135deg,#111827,#312e81 55%,#6d28d9);color:white;border-radius:28px;padding:26px;box-shadow:var(--shadow);position:relative;overflow:hidden}
.hero:after{content:"";position:absolute;width:190px;height:190px;border:35px solid rgba(255,255,255,.07);border-radius:50%;right:-50px;top:-70px}
.hero h1{margin:0 0 7px;font-size:clamp(26px,5vw,42px);letter-spacing:-1.5px}.hero p{margin:0;color:#dbeafe;max-width:720px}
.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:15px 0}.stat{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:17px;box-shadow:var(--shadow)}.stat b{font-size:27px;display:block}.stat small{color:var(--muted)}
.layout{display:grid;grid-template-columns:1.15fr .85fr;gap:15px}.card{background:var(--card);border:1px solid var(--line);border-radius:var(--r);box-shadow:var(--shadow);padding:18px}.card h2{margin:0 0 12px;font-size:18px}.sectionhead{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:10px}
.search{width:100%;padding:12px 14px;border:1px solid var(--line);border-radius:13px;background:#fafafa;margin-bottom:10px}
.tree details{border:1px solid var(--line);border-radius:14px;margin:7px 0;background:#fff}.tree summary{list-style:none;padding:12px;cursor:pointer;font-weight:800;display:flex;align-items:center;gap:8px}.tree summary::-webkit-details-marker{display:none}
.node{padding:0 10px 10px}.topic{display:flex;align-items:center;gap:8px;padding:8px 9px;border-radius:10px}.topic:hover{background:#f8fafc}.topic label{flex:1;font-size:14px}.topic input{accent-color:var(--good);width:18px;height:18px}.tag{font-size:10px;background:#eef2ff;color:#4338ca;padding:3px 7px;border-radius:999px;font-weight:800}
.progress{height:8px;background:#e5e7eb;border-radius:99px;overflow:hidden}.progress i{display:block;height:100%;background:linear-gradient(90deg,var(--accent),var(--accent2));border-radius:99px}
.lottery{min-height:300px;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center}.lottery .emoji{font-size:42px}.picked{font-size:24px;font-weight:900;margin:10px 0;max-width:450px}.meta{color:var(--muted);font-size:13px}.timer{font-size:62px;font-weight:900;letter-spacing:2px;margin:10px}.cool{background:#fff7ed;color:#9a3412;padding:7px 10px;border-radius:9px;font-size:12px;margin-top:6px}
.daybar{display:grid;grid-template-columns:repeat(7,1fr);gap:6px;margin-top:10px}.day{padding:9px 3px;text-align:center;border-radius:10px;background:#f8fafc;font-size:11px}.day b{display:block;font-size:15px}.day.done{background:#dcfce7;color:#166534}
.log{display:flex;justify-content:space-between;gap:8px;padding:10px 0;border-bottom:1px solid var(--line);font-size:13px}.empty{color:var(--muted);padding:18px 0;text-align:center}
.focus{position:fixed;inset:0;background:#080b13;color:#fff;z-index:9999;display:none;align-items:center;justify-content:center;padding:20px}.focus.on{display:flex}.focusbox{width:min(700px,100%);text-align:center}.focus h1{font-size:clamp(30px,7vw,54px);margin:0}.focus .focusTimer{font-size:clamp(70px,18vw,150px);font-weight:900;line-height:1;margin:25px 0}.focus p{color:#aeb7c8}.focus button{margin:5px}.focusWarning{position:fixed;top:12px;left:50%;transform:translateX(-50%);background:#7f1d1d;padding:10px 14px;border-radius:12px;display:none}
.toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:#111827;color:#fff;padding:11px 16px;border-radius:12px;display:none;z-index:10000;box-shadow:var(--shadow)}
@media(max-width:850px){.grid{grid-template-columns:repeat(2,1fr)}.layout{grid-template-columns:1fr}.app{padding:12px 10px 90px}.hero{padding:22px}.actions{justify-content:flex-end}}
@media(max-width:500px){.top{align-items:flex-start}.grid{gap:8px}.stat{padding:13px}.stat b{font-size:22px}.card{padding:14px}.btn{padding:9px 11px}}
</style>
</head>
<body>
<div class="app">
 <div class="top">
  <div class="brand">KAUSHAL <span>• STUDY FOCUS</span></div>
  <div class="actions">
   <button class="btn" onclick="exportData()">Export</button>
   <button class="btn" onclick="document.getElementById('importFile').click()">Import</button>
   <input id="importFile" type="file" accept=".json" hidden onchange="importData(event)">
  </div>
 </div>

 <section class="hero">
  <h1>Study. Track. Revise.</h1>
  <p>Your distraction-resistant CGPSC study dashboard. Tick topics as you cover them, then use the 10-minute revision lottery to keep older topics alive.</p>
  <div style="margin-top:17px;max-width:520px"><div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:5px"><span>Overall syllabus coverage</span><b id="heroPct">0%</b></div><div class="progress" style="background:rgba(255,255,255,.18)"><i id="heroBar" style="width:0%;background:#fff"></i></div></div>
 </section>

 <div class="grid">
  <div class="stat"><b id="todayCount">0</b><small>Topics covered today</small></div>
  <div class="stat"><b id="totalCount">0</b><small>Total topics completed</small></div>
  <div class="stat"><b id="revisionCount">0</b><small>Revisions completed</small></div>
  <div class="stat"><b id="streak">0</b><small>Study-day streak</small></div>
 </div>

 <div class="layout">
  <section class="card">
   <div class="sectionhead"><h2>📚 Hierarchical Syllabus</h2><span class="tag">CGPSC</span></div>
   <input class="search" id="search" placeholder="Search subject or topic..." oninput="renderTree()">
   <div id="tree" class="tree"></div>
  </section>

  <aside>
   <section class="card lottery">
    <div class="emoji">🎟️</div>
    <h2>10-Minute Revision Lottery</h2>
    <div id="pick" class="picked">Ready when you are</div>
    <div id="pickMeta" class="meta">Eligible topics are selected randomly.</div>
    <div id="cooldown" class="cool"></div>
    <button class="btn primary" style="margin-top:15px" onclick="drawTopic()">🎲 Draw Random Topic</button>
    <button class="btn" id="focusBtn" style="margin-top:5px" onclick="startFocus()">🔒 Start 10-Min Focus</button>
   </section>

   <section class="card" style="margin-top:15px">
    <div class="sectionhead"><h2>📅 Last 7 Study Days</h2><span id="weekTotal" class="tag">0 topics</span></div>
    <div id="week" class="daybar"></div>
   </section>

   <section class="card" style="margin-top:15px">
    <div class="sectionhead"><h2>🕘 Recent Activity</h2><button class="btn" onclick="clearActivity()">Clear</button></div>
    <div id="activity"></div>
   </section>
  </aside>
 </div>
</div>

<div id="focus" class="focus" aria-hidden="true">
 <div class="focusbox">
  <div style="font-size:14px;letter-spacing:2px;color:#9ca3af">STRICT STUDY FOCUS</div>
  <h1 id="focusTopic">Revision</h1>
  <div class="focusTimer" id="focusTimer">10:00</div>
  <p>Stay on this screen until the timer ends. Switching tabs will trigger a warning and pause the session.</p>
  <button class="btn primary" onclick="finishFocus()">✓ Complete Revision</button>
  <button class="btn" onclick="exitFocus()">Exit</button>
 </div>
 <div id="focusWarning" class="focusWarning">⚠️ Stay in Focus Mode — timer paused.</div>
</div>
<div id="toast" class="toast"></div>

