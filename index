 const t=TOPICS.find(x=>x.id===noteTid);if(!t)return;
 document.getElementById('nTitle').textContent=t.name;
 document.getElementById('nCrumb').textContent=t.subject+' › '+t.group;
 const a=nl()[noteTid]||[];
 document.getElementById('nList').innerHTML=a.length?a.map(n=>`<div class="nrow"><div class="ninfo"><b>📄 ${esc(n.name)}</b><small>${n.path.includes('/')?'Uploaded file':'Google Drive'}</small></div><button class="btn" onclick="openViewer('${n.id}','${noteTid}')">View</button><button class="btn danger" onclick="delNote('${n.id}')">✕</button></div>`).join(''):'<div class="empty">No PDFs linked to this topic yet.</div>';
}
async function addNote(){
 const t=TOPICS.find(x=>x.id===noteTid);if(!t)return;
 const fid=driveId(document.getElementById('nLink').value);
 if(!fid){nMsg('Could not read that link — paste a Google Drive file link (not a folder).');return}
 const a=(nl()[t.id]=nl()[t.id]||[]);
 const name=document.getElementById('nName').value.trim()||'PDF note '+(a.length+1);
 const note={id:crypto.randomUUID(),name,path:fid,size:0,at:new Date().toISOString(),unsynced:true};
 a.push(note);persist();
 document.getElementById('nLink').value='';document.getElementById('nName').value='';
 renderTree();renderNotes();renderPickDocs();toast('✓ PDF linked');
 try{
  await cloudFetch('revision_notes',{method:'POST',body:JSON.stringify([{id:note.id,topic_id:t.id,subject:t.subject,group_name:t.group,topic_name:t.name,file_name:name,storage_path:fid,size_bytes:0}])});
  delete note.unsynced;persist();
 }catch(e){console.warn('Link sync:',e)}
}
async function delNote(nid){
 const a=nl()[noteTid]||[],n=a.find(x=>x.id===nid);
 if(!n||!confirm('Remove "'+n.name+'" from this topic on all devices? (Your Drive file is not deleted.)'))return;
 nl()[noteTid]=a.filter(x=>x.id!==nid);persist();renderTree();renderNotes();renderPickDocs();
 try{await cloudFetch('revision_notes?id=eq.'+nid,{method:'DELETE'})}catch(e){console.warn('Delete:',e)}
