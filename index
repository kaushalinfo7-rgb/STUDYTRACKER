const KEY="kaushalStudyFocusV1";
let data=JSON.parse(localStorage.getItem(KEY)||'null')||{completed:{},revisions:{},activity:[],current:null};
let focusInterval=null,focusSeconds=600,focusTopicId=null,hidden=false;

function save(){localStorage.setItem(KEY,JSON.stringify(data));scheduleCloud()}
function id(s){return s.toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'')}
function today(){return new Date().toISOString().slice(0,10)}
function addDays(ds,n){let d=new Date(ds+"T12:00:00");d.setDate(d.getDate()+n);return d.toISOString().slice(0,10)}
function fmtDate(d){return new Date(d+"T12:00:00").toLocaleDateString(undefined,{day:"numeric",month:"short"})}
function allTopics(){
 let a=[]; SYLLABUS.forEach(s=>s.children.forEach(c=>c.topics.forEach(t=>a.push({id:id(s.name+"|"+c.name+"|"+t),subject:s.name,group:c.name,name:t}))));
 return a;
}
const TOPICS=allTopics();

function renderTree(){
 const q=document.getElementById("search").value.toLowerCase().trim();
 let html="";
 SYLLABUS.forEach(s=>{
  let groups=s.children.map(c=>{
   let topics=c.topics.filter(t=>!q || (s.name+" "+c.name+" "+t).toLowerCase().includes(q));
   if(q && !topics.length)return "";
   return `<details><summary>▸ ${esc(c.name)} <span class="tag">${topics.length}</span></summary><div class="node">${
    topics.map(t=>{let tid=id(s.name+"|"+c.name+"|"+t),done=!!data.completed[tid];return `<div class="topic"><input type="checkbox" ${done?"checked":""} onchange="toggleTopic('${tid}')"><label>${esc(t)}</label>${done?'<span class="tag">DONE</span>':''}</div>`}).join("")
   }</div></details>`;
  }).join("");
  if(!q || html) html+=`<details ${q?"open":""}><summary>▾ ${esc(s.name)}</summary><div class="node">${groups}</div></details>`;
 });
 document.getElementById("tree").innerHTML=html||'<div class="empty">No topic found.</div>';
}
function esc(s){return s.replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[m]))}
function toggleTopic(tid){
 if(data.completed[tid]){delete data.completed[tid];toast("Topic marked incomplete");}
 else{data.completed[tid]={date:today(),at:Date.now()};data.activity.unshift({type:"covered",tid,date:today(),at:Date.now()});toast("✓ Topic counted for today");}
 save();renderAll();
}
function eligibleTopics(){
 const now=today();
 return TOPICS.filter(t=>{
  let r=data.revisions[t.id];
  return !r || addDays(r.date,10)<=now;
 });
}
function drawTopic(){
 const pool=eligibleTopics();
 if(!pool.length){document.getElementById("pick").textContent="No eligible topics right now";document.getElementById("pickMeta").textContent="Every revision topic is currently inside its 10-day cooldown.";return}
 const t=pool[Math.floor(Math.random()*pool.length)];
 data.current=t.id;save();
 document.getElementById("pick").textContent=t.name;
 document.getElementById("pickMeta").textContent=`${t.subject} • ${t.group}`;
 document.getElementById("cooldown").textContent="Complete the 10-minute focus to start its 10-day revision cooldown.";
}
function startFocus(){
 if(!data.current){drawTopic(); if(!data.current)return}
 const t=TOPICS.find(x=>x.id===data.current); if(!t)return;
 focusTopicId=t.id;focusSeconds=600;hidden=false;
 document.getElementById("focusTopic").textContent=t.name;
 document.getElementById("focus").classList.add("on");
 document.getElementById("focus").setAttribute("aria-hidden","false");
 renderFocusTimer();
 clearInterval(focusInterval);
 focusInterval=setInterval(()=>{if(!hidden){focusSeconds--;renderFocusTimer();if(focusSeconds<=0){clearInterval(focusInterval);finishFocus(true)}}},1000);
}
function renderFocusTimer(){let m=Math.floor(focusSeconds/60),s=focusSeconds%60;document.getElementById("focusTimer").textContent=`${String(m).padStart(2,"0")}:${String(s).padStart(2,"0")}`}
function finishFocus(auto=false){
 if(!focusTopicId)return;
 clearInterval(focusInterval);
 const tid=focusTopicId;
 data.revisions[tid]={date:today(),at:Date.now()};
 data.activity.unshift({type:"revision",tid,date:today(),at:Date.now()});
 data.current=null;focusTopicId=null;save();
 document.getElementById("focus").classList.remove("on");
 toast(auto?"🎉 10-minute revision completed!":"✓ Revision completed");
 renderAll();
}
function exitFocus(){
 clearInterval(focusInterval);focusTopicId=null;
 document.getElementById("focus").classList.remove("on");
}
document.addEventListener("visibilitychange",()=>{
 if(document.hidden && document.getElementById("focus").classList.contains("on")){
  hidden=true;clearInterval(focusInterval);document.getElementById("focusWarning").style.display="block";
 }else if(!document.hidden && document.getElementById("focus").classList.contains("on")){
  hidden=false;document.getElementById("focusWarning").style.display="none";
  focusInterval=setInterval(()=>{if(!hidden){focusSeconds--;renderFocusTimer();if(focusSeconds<=0)finishFocus(true)}},1000);
 }
});
function stats(){
 const total=TOPICS.length, done=Object.keys(data.completed).length;
 document.getElementById("todayCount").textContent=Object.values(data.completed).filter(x=>x.date===today()).length;
 document.getElementById("totalCount").textContent=`${done}/${total}`;
 document.getElementById("revisionCount").textContent=Object.keys(data.revisions).length;
 let streak=0,d=new Date();while(true){let ds=d.toISOString().slice(0,10);let n=Object.values(data.completed).some(x=>x.date===ds)||data.activity.some(x=>x.type==="revision"&&x.date===ds);if(!n)break;streak++;d.setDate(d.getDate()-1);if(streak>999)break}
 document.getElementById("streak").textContent=streak;
 let pct=total?Math.round(done/total*100):0;document.getElementById("heroPct").textContent=pct+"%";document.getElementById("heroBar").style.width=pct+"%";
}
function renderWeek(){
 const box=document.getElementById("week");let total=0,arr=[];
 for(let i=6;i>=0;i--){let d=new Date();d.setDate(d.getDate()-i);let ds=d.toISOString().slice(0,10);let n=Object.values(data.completed).filter(x=>x.date===ds).length+data.activity.filter(x=>x.type==="revision"&&x.date===ds).length;total+=n;arr.push(`<div class="day ${n?'done':''}"><span>${d.toLocaleDateString(undefined,{weekday:'short'}).slice(0,3)}</span><b>${n}</b><small>${d.getDate()}</small></div>`)}
 box.innerHTML=arr.join("");document.getElementById("weekTotal").textContent=total+" activities";
}
function renderActivity(){
 const el=document.getElementById("activity");let a=data.activity.slice(0,12);
 el.innerHTML=a.length?a.map(x=>{let t=TOPICS.find(z=>z.id===x.tid);return `<div class="log"><span>${x.type==="revision"?"🎲":"✓"} ${esc(t?t.name:"Topic")}</span><span>${fmtDate(x.date)}</span></div>`}).join(""):'<div class="empty">No activity yet.</div>';
}
function renderAll(){renderTree();stats();renderWeek();renderActivity()}
function toast(s){let e=document.getElementById("toast");e.textContent=s;e.style.display="block";clearTimeout(window.tt);window.tt=setTimeout(()=>e.style.display="none",1800)}
function clearActivity(){if(confirm("Clear activity history? Completed topics will remain.")){data.activity=[];save();renderAll()}}
function exportData(){
 const blob=new Blob([JSON.stringify(data,null,2)],{type:"application/json"}),a=document.createElement("a");a.href=URL.createObjectURL(blob);a.download="kaushal-study-backup.json";a.click();URL.revokeObjectURL(a.href)
}
function importData(e){
 const f=e.target.files[0];if(!f)return;let r=new FileReader();r.onload=()=>{try{data=JSON.parse(r.result);save();renderAll();toast("✓ Backup imported")}catch(err){alert("Invalid backup file.")}};r.readAsText(f)
}
renderAll();
</script>

<!-- ===== KAUSHAL CLOUD SYNC PATCH ===== -->
<script>
const KAUSHAL_CLOUD={
 url:'https://jxozwhyroherxojhkslg.supabase.co',
 key:'sb_publishable_zQcr8lTMQnzwyEw5DN4j-w_kdoJfYQj'
};
let cloudTimer=null,cloudBusy=false;
function cloudHeaders(){return {'apikey':KAUSHAL_CLOUD.key,'Content-Type':'application/json','Prefer':'resolution=merge-duplicates,return=minimal'}}
async function cloudFetch(path,opts={}){
 const r=await fetch(KAUSHAL_CLOUD.url+'/rest/v1/'+path,{...opts,headers:{...cloudHeaders(),...(opts.headers||{})}});
 if(!r.ok) throw new Error(await r.text());
 return r.status===204?null:r.json();
}
function cloudStatus(text,kind=''){
 let e=document.getElementById('cloudStatus');
 if(!e){e=document.createElement('div');e.id='cloudStatus';e.style.cssText='position:fixed;right:14px;bottom:14px;z-index:9998;background:#111827;color:#fff;padding:9px 12px;border-radius:10px;font:12px system-ui;box-shadow:0 8px 25px #0003';document.body.appendChild(e)}
 e.textContent=text;e.style.background=kind==='ok'?'#047857':kind==='bad'?'#991b1b':'#111827';
 clearTimeout(window.cloudHide);window.cloudHide=setTimeout(()=>e.style.display='none',2200);e.style.display='block';
}
async function cloudPush(){
 if(cloudBusy)return; cloudBusy=true;
 try{
  cloudStatus('☁ Saving to cloud…');
  const completed=Object.entries(data.completed||{}).map(([topic_id,v])=>({topic_id,completed:true,completed_at:new Date(v.at||Date.now()).toISOString(),updated_at:new Date().toISOString()}));
  if(completed.length) await cloudFetch('topic_progress?on_conflict=topic_id',{method:'POST',body:JSON.stringify(completed)});
  const revisions=Object.entries(data.revisions||{}).map(([topic_id,v])=>({topic_id,revised_at:new Date(v.at||Date.now()).toISOString(),next_revision_at:new Date(v.next).toISOString()}));
  if(revisions.length) await cloudFetch('revision_history',{method:'POST',body:JSON.stringify(revisions)});
  const d=new Date().toISOString().slice(0,10);
  const topics=Object.values(data.completed||{}).filter(v=>v.date===d).length;
  const revisionsToday=Object.values(data.revisions||{}).filter(v=>v.date===d).length;
  await cloudFetch('daily_activity?on_conflict=activity_date',{method:'POST',body:JSON.stringify([{activity_date:d,topics_covered:topics,revisions_completed:revisionsToday,total_focus_minutes:revisionsToday*10,updated_at:new Date().toISOString()}])});
  cloudStatus('✓ Cloud synced','ok');
 }catch(e){console.warn('Cloud sync:',e);cloudStatus('Cloud unavailable • saved locally','bad')}
 finally{cloudBusy=false}
}
function scheduleCloud(){clearTimeout(cloudTimer);cloudTimer=setTimeout(cloudPush,900)}
async function cloudPull(){
 try{
  cloudStatus('☁ Syncing…');
  const p=await cloudFetch('topic_progress?select=topic_id,completed,completed_at,updated_at');
  const r=await cloudFetch('revision_history?select=topic_id,revised_at,next_revision_at&order=revised_at.desc');
  if(Array.isArray(p))p.forEach(x=>{if(x.completed)data.completed[x.topic_id]={date:(x.completed_at||'').slice(0,10),at:x.updated_at||new Date().toISOString()};else delete data.completed[x.topic_id]});
  if(Array.isArray(r)){const latest={};r.forEach(x=>{if(!latest[x.topic_id])latest[x.topic_id]=x});Object.entries(latest).forEach(([id,x])=>{data.revisions[id]={date:(x.revised_at||'').slice(0,10),at:x.revised_at,next:x.next_revision_at}})}
  localStorage.setItem('kaushalStudyFocusV1',JSON.stringify(data));
  if(typeof renderAll==='function')renderAll();
  cloudStatus('✓ Cloud loaded','ok');
 }catch(e){console.warn('Cloud pull:',e);cloudStatus('Cloud unavailable • local mode','bad')}
}
// Replace the existing local-only save function with local save + deferred cloud sync.
window.save=function(){localStorage.setItem('kaushalStudyFocusV1',JSON.stringify(data));scheduleCloud()};
window.addEventListener('online',()=>cloudPull());
window.addEventListener('load',()=>setTimeout(cloudPull,700));
</script>

